# Copia este archivo a ".env" para desarrollo local.
#
# Vite solo expone al navegador las variables con prefijo VITE_, y las "hornea"
# en el bundle al compilar: no son secretos, cualquiera puede leerlas en el
# JavaScript publicado. Por eso aquí solo va la URL pública de la API.
#
# En Vercel esta variable NO sale de este archivo (.env está en .gitignore):
# se define en el panel del proyecto, en Settings -> Environment Variables.
# Valor en producción: /api — el front llama a su propio dominio y vercel.json
# reenvía /api/* a https://huebito-api.vercel.app, así la cookie de sesión es
# del mismo sitio y Safari/incógnito no la bloquean.

VITE_API_URL="http://localhost:3000"

# Client ID de OAuth de Google (Google Identity Services). Tampoco es secreto.
# En Vercel: Settings -> Environment Variables.
VITE_GOOGLE_CLIENT_ID="336742067695-jhkg4n144a8pqsa3igldgd1dhnckk9va.apps.googleusercontent.com"
